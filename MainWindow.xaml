<Window x:Class="WPF_Jokes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Jokes"
        mc:Ignorable="d"
        Title="Jokes" Height="450" Width="800">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Button Content="Fetch and Save 10 Jokes" 
                Click="FetchAndSaveJokes_Click" 
                Margin="10" 
                HorizontalAlignment="Left"/>

			<ListBox x:Name="lbJokeListBox" 
                 Grid.Row="1" 
                 Margin="10" 
                 VerticalContentAlignment="Top"/>

			<TextBlock x:Name="tbStatusText" 
                   Grid.Row="2" 
                   Margin="10" 
                   Foreground="DarkGreen" 
                   TextWrapping="Wrap"/>
		</Grid>
	</Window>
